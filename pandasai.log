import pandas as pd
sql_query = """
-- Find the cheapest whole meal combo by assuming a combo is defined as 
-- one burger (Chicken or Beef), French Fries, and a Soft Drink
-- Calculate the total price for each burger combo and pick the cheapest

WITH BurgerPrices AS (
    SELECT FoodItemID, ItemName, Price
    FROM table_from_bytes
    WHERE ItemName IN ('Chicken Burger', 'Beef Burger')
),
